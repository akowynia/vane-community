# ==========================================
# Vane-Community Environment Configuration
# ==========================================

# API authorization key (recommended/required in production and public environments)
# Protects all /api/* endpoints from unauthorized access.
# Supported headers: 'Authorization: Bearer <API_KEY>', 'x-api-key: <API_KEY>' or the 'vane_api_key' cookie.
# Note: When no key is set, configuration changes and model provider registration are blocked (403 Forbidden).
API_KEY=

# Alternative names for the authorization key variable:
# AUTH_SECRET=
# VANE_API_KEY=

# URL of the SearXNG search instance (default: http://127.0.0.1:8080)
SEARXNG_API_URL=http://127.0.0.1:8080

# Server port and host
PORT=3000
HOSTNAME=0.0.0.0
